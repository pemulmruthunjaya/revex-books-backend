# Local development uses NODE_ENV=development.
# Live deployment must use NODE_ENV=production.
NODE_ENV=development
PORT=3000

DB_HOST=your-database-host
DB_PORT=3306
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_NAME=your-database-name

# Minimum 32 characters. Use a random value and never share it.
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-characters
JWT_EXPIRES_IN=1d

# Local: http://localhost:5173
# Live: https://your-frontend-domain.com
CORS_ORIGINS=http://localhost:5173
JSON_BODY_LIMIT=1mb
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=1000
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=20

# Public frontend URL used in staff invitations and password-reset links.
APP_URL=http://localhost:5173

# Production email uses Microsoft Graph application permissions. Never commit
# real tenant IDs, client IDs, or client secrets.
EMAIL_PROVIDER=microsoft_graph
MS_GRAPH_TENANT_ID=00000000-0000-4000-8000-000000000000
MS_GRAPH_CLIENT_ID=00000000-0000-4000-8000-000000000000
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER=support@revexbooks.com

BACKUP_COMPANY_ID=
BACKUP_DIR=backups

# Daily recurring invoice generation (default: 01:00 server time).
RECURRING_INVOICE_SCHEDULER_ENABLED=true
RECURRING_INVOICE_CRON=0 1 * * *
